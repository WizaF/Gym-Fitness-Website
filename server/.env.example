# ---- Server ----
PORT=5000
NODE_ENV=development
# Origin of the React app (used for CORS). In dev the Vite proxy is used, so this is just a safeguard.
CLIENT_URL=http://localhost:5173
# Timezone used for "next class date" calculation and in emails
TIMEZONE=Asia/Kolkata

# ---- MongoDB ----
MONGO_URI=mongodb://127.0.0.1:27017/gymsync

# ---- Sessions / cookies ----
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string
# Only change if client and API are on DIFFERENT domains in production ("none" requires HTTPS)
COOKIE_SAMESITE=lax

# ---- Email (booking confirmations) ----
# Leave SMTP_HOST empty to only LOG emails to the console (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="GymSync <no-reply@yourdomain.com>"
